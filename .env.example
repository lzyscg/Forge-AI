# Pi mode: fake | real
PI_MODE=fake

# SQLite database path
DB_PATH=./data/forge.db

# Scenario config path
SCENARIO_PATH=./scenarios/songwriting/scenario.yaml

# DeepSeek API (used by Pi SDK - DO NOT commit real keys)
# 铁律 6：API Key 不进日志/数据库/前端
DEEPSEEK_API_KEY=your-api-key-here

# Pi model ID (deepseek-v4-flash or deepseek-v4-pro)
PI_MODEL_ID=deepseek-v4-flash
